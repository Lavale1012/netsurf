{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Comment": "'localhost' (not 127.0.0.1) so Kestrel binds both loopbacks. Ports 5000 and 7000 are taken by macOS AirPlay Receiver.",
        "Url": "http://localhost:5080"
      }
    }
  },

  "ReverseProxy": {
    "Routes": {
      "go-ws": {
        "ClusterId": "go",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/ws" },
        "Transforms": [
          {
            "RequestHeader": "Origin",
            "Set": "http://gateway.internal"
          }
        ]
      },

      "go-network": {
        "ClusterId": "go",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/network/{**catchall}" }
      },

      "go-stream-health": {
        "ClusterId": "go",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/stream/health" },
        "Transforms": [ { "PathSet": "/health" } ]
      }
    },

    "Clusters": {
      "go": {
        "Destinations": {
          "primary": { "Address": "http://127.0.0.1:8000/" }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:10:00",
          "Version": "1.1",
          "VersionPolicy": "RequestVersionOrLower"
        }
      }
    }
  }
}
